    {
      "parameters": {
        "jsCode": "const binaryKeys = Object.keys($binary || {});\nconst hasAttachment = binaryKeys.length > 0;\n\nlet newBinary = {};\nif (hasAttachment) {\n  const firstKey = binaryKeys[0];\n  const file = $binary[firstKey];\n\n  // Make sure file exists and has required props\n  if (file && file.data) {\n    newBinary['resume.pdf'] = file;\n  }\n}\n\nreturn [\n  {\n    json: {\n      hasAttachment,\n      email: $json.from?.value?.[0]?.address || \"unknown@example.com\"\n    },\n    binary: newBinary\n  }\n];\n\n"
      },
