      "parameters": {
        "jsCode": "// Step 1: Get the raw output string from the AI agent\nconst rawOutput = $json.output;\n\n// Step 2: Extract the JSON portion from the string\nconst jsonStart = rawOutput.indexOf('{');\nconst jsonEnd = rawOutput.lastIndexOf('}');\nconst jsonString = rawOutput.slice(jsonStart, jsonEnd + 1);\n\n// Step 3: Parse the string into an actual JSON object\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonString);\n} catch (error) {\n  throw new Error(\"Failed to parse JSON: \" + error.message);\n}\n\n// Optional cleanup: Force contact_number to be string\nif (parsed.contact_number) {\n  parsed.contact_number = parsed.contact_number.toString();\n}\n\n// Step 4: Return the structured data\nreturn [\n  {\n    json: parsed\n  }\n];\n"
      },
