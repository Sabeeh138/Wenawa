      "parameters": {
        "jsCode": "const classification = $json.output;\n\n// Map classification to the correct sheet tab name\nconst sheetMap = {\n  \"AI\": \"AI\",\n  \"MEAN/MERN\": \"MEAN/MERN\",\n  \"Web\": \"Web\",\n  \"Mobile\": \"Mobile\",\n  \"UI/UX\": \"UI/UX\",\n  \"Flutter Developer\": \"Flutter Developer\",\n  \"DotNet\": \"DotNet\",\n  \"DevOps\": \"DevOps\",\n  \"Marketing\": \"Marketing\",\n  \"Customer Service\": \"Customer Service\",\n  \"Other\": \"Other\",\n};\n\n// Use \"Other\" as fallback\nconst sheetName = sheetMap[classification] || \"Other\";\n\n// Return all fields along with sheetName\nreturn [\n  {\n    json: {\n      ...$json,\n      sheetName\n    }\n  }\n];\n"
      },
