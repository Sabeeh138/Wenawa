        "jsCode": "// Get the AI classification result from the previous node\nconst classification = $input.first().json.output;\n\n// Map each classification to its Google Drive folder ID\nconst folderMap = {\n  \"AI\": \"1HDuqwffnZvDk-nWS-dM2q0Jw2zSQs-hi\",\n  \"Web\": \"1elZ0G__VvbLMJavORYz49wZmc_a5EbLa\",\n  \"Mobile\": \"1va3eBzVRsuE-UqK6v9S8984K47OUpPuO\",\n  \"UI\": \"1LeWbGlChDsSowiAssoRH3GN36s_0VlHu\",\n  \"UX\": \"1LeWbGlChDsSowiAssoRH3GN36s_0VlHu\", // Assuming same as UI\n  \"Flutter Developer\": \"1D1kSBeAkE3BtWa6WoABfHp1Toxs992g5\",\n  \"DotNet\": \"1UvbtrSRFY7mHGrF1tt_E7ko-AMwZoWUj\",\n  \"DevOps\": \"1a2nlPcrxxzJwXqJlwFZl37tbUZSIEgE7\",\n  \"Marketing\": \"1b0-PMdMPIC5ah2u3F4ft_8dOHMhQyJiZ\",\n  \"Customer Service\": \"1pUHRS_0HYtdjuE0UbFmS9Z3qqRy5iOXD\",\n  \"Other\": \"1uFQvabku8Gsx2W11_C-_er7FoP0ez8KM\",\n};\n\n// Look up the folder ID based on the classification\nconst folderId = folderMap[classification] || folderMap[\"Other\"]; // fallback to \"Other\" if unknown\n\n// Return it as part of the new output\nreturn [\n  {\n    json: {\n      ...$json,\n      folderId: folderId\n    }\n  }\n];\n"
